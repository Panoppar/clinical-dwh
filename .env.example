# ============================================================================
# Regional Health & Population Data Warehouse — Environment Configuration
# Copy this file to `.env` before running `docker compose up`.
# ============================================================================

# ---- Data Warehouse database (hosts bronze / silver / gold schemas) ----
DWH_DB_HOST=warehouse-db
DWH_DB_PORT=3306
DWH_DB_USER=dwh_elt
DWH_DB_PASSWORD=ChangeMe_DWH_2026!
DWH_DB_ROOT_PASSWORD=ChangeMe_DWH_Root_2026!

# Read-only, gold-schema-only account — this is what you enter into Metabase.
# NOTE: created in sql/00_init_schemas_and_grants.sql — if you change the
# password here, update that file to match (it's plain SQL, not
# env-templated, since it only runs once at first container boot).
DWH_METABASE_RO_USER=metabase_ro
DWH_METABASE_RO_PASSWORD=ChangeMe_Metabase_Ro_2026!

# Read-only, gold-schema-only account for kmch-ml's training pipeline to
# pull features directly from the warehouse. Same NOTE as above applies --
# created in sql/00_init_schemas_and_grants.sql, update both together.
DWH_KMCH_ML_RO_USER=kmch_ml_ro
DWH_KMCH_ML_RO_PASSWORD=ChangeMe_Kmch_Ml_Ro_2026!

# ---- Metabase ----
METABASE_DB_FILE=/metabase-data/metabase.db
MB_JETTY_PORT=3000

# ---- Landing zone (SeaweedFS, S3-compatible) for the live-API Bronze
# sources: NSO, BMA, DDS, HDC, DIW -- see pipeline/landing_store.py. Raw
# API responses land here, versioned and content-hashed, before Bronze
# shreds them into tables; elt-runner itself never writes these bytes to
# its own container disk. NOTE: the access/secret key pair here must
# match seaweedfs_s3_config.json (copy from the .example and edit both
# together if you change this password -- that file isn't env-templated,
# it's read directly by the SeaweedFS binary). MinIO was the original
# choice but its free container distribution was discontinued across
# every registry (Docker Hub, quay.io, direct binary download all
# blocked as of this build) -- confirmed by direct testing. ----
LANDING_ACCESS_KEY=dwh_landing
LANDING_SECRET_KEY=ChangeMe_Landing_2026!
LANDING_ENDPOINT=landing-zone:8333
LANDING_BUCKET=landing-zone

# ---- Host port mappings (left side = host, change if you have collisions) ----
DWH_DB_HOST_PORT=3308
METABASE_HOST_PORT=3000
LANDING_S3_HOST_PORT=8333
LANDING_FILER_UI_HOST_PORT=8888
