# ============================================================================
# VaccineWork Medallion DWH — Environment Configuration
# Copy this file to `.env` before running `docker compose up`.
# ============================================================================

# ---- Source OLTP database (simulates the live healthcare web portal) ----
SOURCE_DB_HOST=source-db
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=vaccinework
SOURCE_DB_USER=vaccinework_app
SOURCE_DB_PASSWORD=ChangeMe_Source_2026!
SOURCE_DB_ROOT_PASSWORD=ChangeMe_Source_Root_2026!

# ---- Data Warehouse database (hosts bronze / silver / gold schemas) ----
DWH_DB_HOST=warehouse-db
DWH_DB_PORT=3306
DWH_DB_USER=dwh_elt
DWH_DB_PASSWORD=ChangeMe_DWH_2026!
DWH_DB_ROOT_PASSWORD=ChangeMe_DWH_Root_2026!

# Read-only, gold-schema-only account — this is what you enter into Metabase.
# NOTE: these credentials are created in sql/00_init_schemas_and_grants.sql.
# If you change the passwords here, update that file to match (the init
# script is plain SQL, not env-templated, since it only runs once at
# first container boot).
DWH_METABASE_RO_USER=metabase_ro
DWH_METABASE_RO_PASSWORD=ChangeMe_Metabase_Ro_2026!

# ---- Metabase ----
METABASE_DB_FILE=/metabase-data/metabase.db
MB_JETTY_PORT=3000

# ---- Host port mappings (left side = host, change if you have collisions) ----
SOURCE_DB_HOST_PORT=3307
DWH_DB_HOST_PORT=3308
METABASE_HOST_PORT=3000
